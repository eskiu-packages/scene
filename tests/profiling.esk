// The reference scene for profiling (docs/profiling.md): a fixed workload (400 lit
// objects, a shadow, bloom, animations, physics, particles and simulated app work) rendered
// offscreen with Scene_profile on, its per-stage breakdown printed; then a sub-scene entered
// and left again and again, as a separate Scene and as a subtree of the main one, failing
// when the counts do not return to their baseline.
import <io>;
import <mem>;
import <libc>;
import <list>;
import <string>;
import <gpu>;
import <gpu/math>;
import <scene>;
import <scene/stats>;
import <scene/animation>;
import <scene/physics>;
import <scene/particles>;

int fails = 0;

void check(string what, bool ok) {
    if (!ok) {
        printf("FAIL %s\n", what);
        fails++;
    }
}

struct World {
    int box;
    int ball;
    int plane;
    List<int> mats;
    SceneAnimations anims;
    ScenePhysicsWorld physics;
}

// The app's own simulation: a fixed amount of arithmetic, about the same time every frame.
double app_work(int n) {
    double acc = 0.0;
    for (i in 0..n) acc = acc + sin((double)i * 0.001) * cos((double)i * 0.002);
    return acc;
}

Result<int, string> build(*Scene scene, *World w) {
    SceneGeometry box = scene_box(0.6, 0.6, 0.6);
    w.box = scene.add_geometry(&box)?;
    box.free();
    SceneGeometry ball = scene_sphere(0.35, 24, 12);
    w.ball = scene.add_geometry(&ball)?;
    ball.free();
    SceneGeometry plane = scene_box(40.0, 0.1, 40.0);
    w.plane = scene.add_geometry(&plane)?;
    plane.free();
    for (i in 0..8) {
        SceneMaterial m = scene_material(i % 2 == 0 ? SCENE_PBR : SCENE_BLINN);
        m.diffuse = Vec4{0.2 + 0.1 * (float)i, 0.5, 0.9 - 0.1 * (float)i, 1.0};
        m.roughness = 0.5;
        if (i == 7) m.emissive = Vec3{3.0, 2.0, 0.5};
        List_push(&w.mats, scene.add_material(m));
    }
    scene.add_object(0, w.plane, w.mats.data[0]);
    w.anims = scene_animations();
    int spin = w.anims.group(2.0, SCENE_EASE_LINEAR);
    w.anims.set(spin, SCENE_ANIM_ROTATE_Y, SCENE_ANIM_ADD, 3.14159265);
    for (z in 0..20) {
        for (x in 0..20) {
            int k = z * 20 + x;
            int n = scene.add_object(0, k % 3 == 0 ? w.ball : w.box, w.mats.data[k % 8]);
            scene.node(n).position = Vec3{(float)x - 9.5, 0.4, (float)z - 9.5};
            if (k % 4 == 0) w.anims.play(scene, n, spin, true, 0.0);
        }
    }
    w.physics = scene_physics();
    int floor = scene.add_node(0, "floor");
    w.physics.add(scene, floor, SCENE_BODY_STATIC, 0.0, scene_physics_box(Vec3{40.0, 0.1, 40.0}));
    for (i in 0..40) {
        int n = scene.add_object(0, w.ball, w.mats.data[i % 8]);
        scene.node(n).position = Vec3{(float)(i % 8) - 3.5, 3.0 + (float)(i / 8), 2.0};
        w.physics.add(scene, n, SCENE_BODY_DYNAMIC, 1.0, scene_physics_sphere(0.35));
    }
    SceneLight sun = scene_directional(Vec3{-0.4, -1.0, -0.3}, Vec3{1.0, 0.95, 0.9}, 2.0);
    sun.casts_shadows = true;
    scene.add_light(sun);
    scene.add_light(scene_ambient(Vec3{0.4, 0.45, 0.5}, 0.3));
    int cam = scene.add_camera(0, scene_perspective(0.9, 0.1, 100.0));
    scene.node(cam).position = Vec3{0.0, 9.0, 14.0};
    scene.look_at(cam, Vec3{0.0, 0.0, 0.0}, Vec3{0.0, 1.0, 0.0});
    scene.set_camera(cam);
    scene.post.tone_mapping = SCENE_TONE_HABLE;
    scene.post.bloom = true;
    return Ok<int, string>(0);
}

// One frame of the reference loop at time t: app work, animations, physics, particles,
// the render into target, and the frame closed.
Result<int, string> frame(*Scene scene, *World w, *SceneParticleEmitter e, *GpuTexture target, double t) {
    scene.stage_begin(SCENE_STAGE_APP);
    app_work(20000);
    scene.stage_end(SCENE_STAGE_APP);
    w.anims.update(scene, t);
    w.physics.update(scene, t);
    if (e != null) e.update(scene, t)?;
    scene.render_to(target)?;
    scene.frame_end();
    return Ok<int, string>(0);
}

// A sub-scene as a Scene of its own: made, filled, drawn a few frames, released.
Result<int, string> separate_scene(*Gpu gpu, *GpuTexture target) {
    Scene sub = gpu.scene()?;
    defer sub.release();
    SceneGeometry g = scene_sphere(1.0, 32, 16);
    int mesh = sub.add_geometry(&g)?;
    g.free();
    uint8[16] px = {255, 0, 0, 255, 0, 255, 0, 255, 0, 0, 255, 255, 255, 255, 255, 255};
    GpuTexture tex = gpu.image(2, 2, &px[0])?;
    SceneMaterial m = scene_material(SCENE_PBR);
    m.diffuse_texture = sub.add_texture(tex);
    sub.add_object(0, mesh, sub.add_material(m));
    sub.add_light(scene_directional(Vec3{0.0, -1.0, -1.0}, Vec3{1.0, 1.0, 1.0}, 2.0));
    int cam = sub.add_camera(0, scene_perspective(0.9, 0.1, 50.0));
    sub.node(cam).position = Vec3{0.0, 0.0, 4.0};
    sub.set_camera(cam);
    sub.msaa = 4;
    sub.post.bloom = true;
    for (f in 0..3) sub.render_to(target)?;
    return Ok<int, string>(0);
}

// A sub-scene as a subtree of the main scene: its own nodes over the main scene's meshes
// and materials, a particle emitter, drawn a few frames, then removed.
Result<int, string> subtree(*Scene scene, *World w, *GpuTexture target, double t) {
    int root = scene.add_node(0, "room");
    for (i in 0..30) {
        int n = scene.add_object(root, w.box, w.mats.data[i % 8]);
        scene.node(n).position = Vec3{(float)(i % 6) - 2.5, 2.0, (float)(i / 6) - 2.0};
    }
    SceneParticleEmitter e = scene_particles(scene, root)?;
    e.rate_per_second = Vec2{600.0, 600.0};
    for (f in 0..3) frame(scene, w, &e, target, t + (double)f / 60.0)?;
    e.free(scene);
    scene.remove(root);
    return Ok<int, string>(0);
}

Result<int, string> run() {
    Gpu gpu = gpu_open()?;
    defer gpu.release();
    GpuTexture target = gpu.target(1280, 720)?;
    defer target.release();
    Scene scene = gpu.scene()?;
    defer scene.release();
    World w;
    build(&scene, &w)?;
    defer w.anims.free();
    defer w.physics.free();
    defer w.mats.free();

    int spot = scene.add_node(0, "fountain");
    scene.node(spot).position = Vec3{0.0, 0.5, 3.0};
    SceneParticleEmitter fountain = scene_particles(&scene, spot)?;
    fountain.rate_per_second = Vec2{100.0, 100.0};
    defer fountain.free(&scene);

    // the workload: 30 frames to warm up (pipelines made), then 120 measured
    scene.profile(true);
    double t = 0.0;
    for (f in 0..30) {
        frame(&scene, &w, &fountain, &target, t)?;
        t += 1.0 / 60.0;
    }
    SceneFrameStats warm = scene.frame_stats();
    check("frames counted", warm.frame == 29);
    scene.profile(true);
    for (f in 0..120) {
        frame(&scene, &w, &fountain, &target, t)?;
        t += 1.0 / 60.0;
    }
    gpu.wait();
    String report;
    defer report.free();
    scene.stats_report(&report);
    printf("reference workload, 1280x720 offscreen, bloom, one shadow map:\n%s", report.data);
    SceneStatsSummary sum = scene.stats_summary();
    SceneFrameStats last = scene.frame_stats();
    check("a full window", sum.frames == 120);
    check("stages timed", sum.avg.cpu_ms[SCENE_STAGE_APP] > 0.0 && sum.avg.cpu_ms[SCENE_STAGE_ENCODE] > 0.0 &&
        sum.avg.cpu_ms[SCENE_STAGE_CULL] > 0.0 && sum.avg.cpu_ms[SCENE_STAGE_ANIMATION] > 0.0 &&
        sum.avg.cpu_ms[SCENE_STAGE_PHYSICS] > 0.0 && sum.avg.cpu_ms[SCENE_STAGE_PARTICLES] > 0.0 &&
        sum.avg.cpu_ms[SCENE_STAGE_SUBMIT] > 0.0);
    check("the stages add up", sum.avg.cpu_total_ms <= sum.avg.frame_ms + 0.5);
    check("draws counted", sum.max.draws >= 400);
    check("one shadow map a frame", last.shadow_maps == 1);
    check("no pipeline made after the warm-up", sum.max.pipelines_made == 0);
    if (gpu.timestamps) {
        check("the GPU timed", sum.gpu_frames > 0 && sum.avg.gpu_ms > 0.0);
    } else {
        check("no GPU time without timestamps", sum.gpu_frames == 0 && last.gpu_ms < 0.0);
    }

    // the cost of measuring: the same frames with profiling off and on
    for (round in 0..2) {
        scene.profile(false);
        double t0 = scene_clock_ms();
        for (f in 0..60) {
            frame(&scene, &w, null, &target, t)?;
            t += 1.0 / 60.0;
        }
        gpu.wait();
        double off_ms = (scene_clock_ms() - t0) / 60.0;
        scene.profile(true);
        t0 = scene_clock_ms();
        for (f in 0..60) {
            frame(&scene, &w, null, &target, t)?;
            t += 1.0 / 60.0;
        }
        gpu.wait();
        double on_ms = (scene_clock_ms() - t0) / 60.0;
        if (round == 1) printf("frame time with profiling off %.3f ms, on %.3f ms\n", off_ms, on_ms);
    }

    // a separate sub-scene: once to warm up, then the counts must not move
    separate_scene(&gpu, &target)?;
    gpu.wait();
    SceneCounts base = scene.counts();
    for (i in 0..10) separate_scene(&gpu, &target)?;
    gpu.wait();
    SceneCounts after = scene.counts();
    String grew;
    defer grew.free();
    int n = after.growth(&base, &grew);
    if (n > 0) printf("separate scene, after 10 rounds:\n%s", grew.data);
    check("a separate scene leaves nothing behind", n == 0);

    // a subtree of the main scene: warm up, then only the ids of removed nodes may grow
    subtree(&scene, &w, &target, t)?;
    gpu.wait();
    base = scene.counts();
    for (i in 0..10) subtree(&scene, &w, &target, t + (double)i)?;
    frame(&scene, &w, null, &target, t + 20.0)?;
    gpu.wait();
    after = scene.counts();
    String_clear(&grew);
    n = after.growth(&base, &grew);
    printf("subtree, after 10 rounds:\n%s", n > 0 ? grew.data : "nothing grew\n");
    check("live nodes back to the baseline", after.nodes == base.nodes && after.node_gpu == base.node_gpu);
    check("GPU objects back to the baseline", after.gpu.buffers == base.gpu.buffers &&
        after.gpu.buffer_bytes == base.gpu.buffer_bytes && after.gpu.textures == base.gpu.textures &&
        after.gpu.bind_groups == base.gpu.bind_groups && after.gpu.render_pipelines == base.gpu.render_pipelines);
    check("live meshes and materials back to the baseline", after.meshes == base.meshes && after.materials == base.materials);
    return Ok<int, string>(0);
}

int main() {
    Result<int, string> r = run();
    if (!r.ok) {
        printf("error: %s\n", r.error);
        return 1;
    }
    if (fails == 0) printf("ok\n");
    return fails == 0 ? 0 : 1;
}
